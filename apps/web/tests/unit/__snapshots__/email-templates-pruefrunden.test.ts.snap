exports[`E-Mail-Templates Pruefrunden: Snapshots + deutsche Strings > T-101 pruefrunde-neue-anmeldung > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Jana meldet sich als Tester:in zu „Erster Test der Onboarding-Strecke&quot;.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Neue Anmeldung zu deiner Feedback-Loop</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Jana<!-- --> hat sich als Tester:in für deine Feedback-Loop<!-- --> <!-- -->„<!-- -->Erster Test der Onboarding-Strecke<!-- -->“ zu deinem Werk „<!-- -->Werkzirkel-Onboarding-App<!-- -->“ angemeldet.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Stand jetzt: <!-- -->2<!-- --> von <!-- -->5<!-- --> Plätzen belegt.<!-- --> <!-- -->Du suchst noch 3 weitere Tester:innen.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/pruefrunden/p-1" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Feedback-Loop ansehen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">So funktioniert der Kreis: Wer Feedback sammelt, gibt im Gegenzug Feedback. Sobald deine Tester:innen ihre Rückmeldungen abgegeben haben, bekommst du eine Nachricht.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates Pruefrunden: Snapshots + deutsche Strings > T-102 pruefrunde-neues-feedback > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Neue Rueckmeldung zu „Erster Test der Onboarding-Strecke&quot; — schau rein.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Neues Feedback zu deinem Werk</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Es gibt neues Feedback zu deiner Feedback-Loop „<!-- -->Erster Test der Onboarding-Strecke<!-- -->“ für dein Werk „<!-- -->Werkzirkel-Onboarding-App<!-- -->“. <!-- -->Bisher 3 Rückmeldungen erhalten.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Schau rein und markiere, was dir wirklich geholfen hat. Markiertes Feedback wird auf deinem Werk anonym sichtbar — so erkennen andere, woran du gearbeitet hast.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/pruefrunden/p-1" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Feedback ansehen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Werkzirkel ist eine Werkstatt: ehrliche Rückmeldungen sind ihr wertvollster Rohstoff. Nimm dir Zeit für die Antworten.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates Pruefrunden: Snapshots + deutsche Strings > T-103 reziprozitaet-frist-3d > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Deine Reziprozitaets-Frist endet am 16. Mai 2026.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Noch 3 Tage bis zu deiner Gegenseitigkeits-Frist</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Du hast vor einer Weile eine Feedback-Loop gestartet und im Gegenzug versprochen, zwei Werke anderer zu testen. Die Frist dafür endet am<!-- --> <!-- -->16. Mai 2026<!-- -->. <!-- -->Noch 2 Tests sind offen.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Such dir eine offene Feedback-Loop aus und gib ehrliches Feedback. So bleibt der Kreis lebendig — und du kannst danach wieder eigene Feedback-Loops starten.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/pruefrunden?stadt=hh" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Feedback-Loops ansehen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Werkzirkel funktioniert nur, wenn jeder gibt, was er nimmt. Drei Tage reichen für ein paar Tests — leg los, solange du Ruhe hast.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates Pruefrunden: Snapshots + deutsche Strings > T-104 reziprozitaet-frist-1d > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Letzte Erinnerung: deine Reziprozitaets-Frist endet morgen (14. Mai 2026).<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Letzte Erinnerung: deine Gegenseitigkeits-Frist endet morgen</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Morgen, am <!-- -->14. Mai 2026<!-- -->, läuft deine Gegenseitigkeits-Frist ab.<!-- --> <!-- -->Noch 1 Test ist offen.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Wenn du bis dahin keine Tests abgibst, kannst du keine neuen Feedback-Loops starten, bis du das nachholst. Deine bestehenden Werke bleiben unberührt — nur der Start neuer Feedback-Loops ruht.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/pruefrunden?stadt=hh" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Jetzt eine Feedback-Loop testen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Ein Test dauert je nach Werk 15 bis 60 Minuten. Such dir eines aus, bei dem du wirklich etwas zu sagen hast — der Werkstatt-Kreis lebt von ehrlichen Rückmeldungen.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;
