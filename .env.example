# ────────────────────────────────────────────────
# Werkzirkel — Environment-Vorlage
# Lokale Datei `.env` davon kopieren und befüllen.
# Niemals committen.
# ────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3210
APP_URL=http://localhost:3210

# Datenbank (lokal via docker compose)
DATABASE_URL=postgresql://werkzirkel:werkzirkel_dev@localhost:5432/werkzirkel

# Auth (Better-Auth)
BETTER_AUTH_SECRET=                       # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3210

# E-Mail (Resend)
RESEND_API_KEY=
EMAIL_FROM="Werkzirkel <postmaster@werkzirkel.de>"

# Zahlung (Stripe — Test-Modus)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_FOERDER_MONATLICH=
STRIPE_PRICE_FOERDER_JAEHRLICH=
STRIPE_PRICE_FOERDERER_PRIVAT=
STRIPE_PRICE_FOERDERER_ORG=

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=werkzirkel-public
R2_PUBLIC_URL=https://media.werkzirkel.de

# Cron (interne Job-Endpoints)
CRON_SECRET=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_URL=

# Seed-Defaults (nur lokal/dev)
SEED_ADMIN_EMAIL=admin@werkzirkel.de
SEED_KURATOR_HH_EMAIL=hamburg@werkzirkel.de
