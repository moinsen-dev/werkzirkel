exports[`E-Mail-Templates: Snapshots + deutsche Strings > T-001 magic-link-login > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Dein Anmelde-Link ist 15 Minuten gültig.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Anmelde-Link für deinen Werkzirkel</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Klick auf den Knopf unten, um dich in deinem Werkzirkel-Konto anzumelden. Der Link ist <!-- -->15<!-- --> Minuten gültig und kann nur einmal verwendet werden.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/api/v1/auth/magic-link/verify?token=demo" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Jetzt anmelden</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 8px 0;margin-top:24px;margin-right:0;margin-bottom:8px;margin-left:0">Falls der Knopf nicht funktioniert, kopier diese Adresse in deinen Browser:</p><p style="font-size:13px;line-height:24px;word-break:break-all;color:#57534e;font-family:monospace;background-color:#f5f5f4;padding:12px;border-radius:4px;margin-top:16px;margin-bottom:16px">https://werkzirkel.de/api/v1/auth/magic-link/verify?token=demo</p><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Hast du keine Anmeldung angefordert? Ignorier diese E-Mail einfach — ohne Klick passiert nichts.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates: Snapshots + deutsche Strings > T-002 magic-link-registrierung > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Hallo Jana — bestätige deine E-Mail, dann geht&#x27;s los.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Schön, dass du da bist, <!-- -->Jana<!-- -->.</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Du hast dich beim Werkzirkel angemeldet. Klick auf den Knopf unten, um deine E-Mail-Adresse zu bestätigen und dein Konto freizuschalten.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/api/v1/auth/magic-link/verify?token=demo" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">E-Mail bestätigen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 8px 0;margin-top:24px;margin-right:0;margin-bottom:8px;margin-left:0">Falls der Knopf nicht funktioniert, kopier diese Adresse in deinen Browser:</p><p style="font-size:13px;line-height:24px;word-break:break-all;color:#57534e;font-family:monospace;background-color:#f5f5f4;padding:12px;border-radius:4px;margin-top:16px;margin-bottom:16px">https://werkzirkel.de/api/v1/auth/magic-link/verify?token=demo</p><p style="font-size:14px;line-height:24px;margin:24px 0 8px 0;margin-top:24px;margin-right:0;margin-bottom:8px;margin-left:0">Werkzirkel ist kein Marktplatz, sondern eine Werkstatt: erst zeigen, was du baust — dann findet sich, was du brauchst. Schau dich um, leg ein Werk an und gib anderen ehrliches Feedback.</p><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Hast du dich nicht angemeldet? Ignorier diese E-Mail — dann passiert nichts.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates: Snapshots + deutsche Strings > T-003 konto-loeschung-bestaetigung > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Klick zur Bestätigung — Löschung am 28.05.2026.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Möchtest du dein Konto wirklich löschen?</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Du hast in den Einstellungen die Löschung deines Werkzirkel-Kontos angefordert. Wir wollen sichergehen, dass das wirklich du bist.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Mit einem Klick auf den Knopf unten startet eine 7-tägige Karenzzeit. In diesen 7 Tagen kannst du die Löschung jederzeit widerrufen. Wenn du den Knopf jetzt klickst, wird dein Konto<!-- --> <strong>voraussichtlich am <!-- -->28.05.2026</strong> <!-- -->endgültig gelöscht — mit all deinen Werken, deinem Profil und allen persönlichen Daten.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/api/v1/me/confirm-deletion?token=demo" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#b91c1c;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Löschung bestätigen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 8px 0;margin-top:24px;margin-right:0;margin-bottom:8px;margin-left:0">Falls der Knopf nicht funktioniert, kopier diese Adresse in deinen Browser:</p><p style="font-size:13px;line-height:24px;word-break:break-all;color:#57534e;font-family:monospace;background-color:#f5f5f4;padding:12px;border-radius:4px;margin-top:16px;margin-bottom:16px">https://werkzirkel.de/api/v1/me/confirm-deletion?token=demo</p><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Hast du die Löschung nicht angefordert? Ignorier diese E-Mail — dann bleibt dein Konto wie es ist.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates: Snapshots + deutsche Strings > T-004 konto-loeschung-erinnerung > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Endgültige Löschung am 15. Mai 2026 — du kannst noch widerrufen.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Letzte Erinnerung: Dein Konto wird in 2 Tagen gelöscht</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Vor ein paar Tagen hast du die Löschung deines Werkzirkel-Kontos angefordert. Am <!-- -->15. Mai 2026<!-- --> ist es endgültig soweit: deine Werke, dein Profil und alle persönlichen Daten werden entfernt.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Falls du es dir anders überlegt hast, kannst du die Löschung jetzt noch zurücknehmen.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin:24px 0"><tbody><tr><td><a href="https://werkzirkel.de/api/v1/me/cancel-deletion" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#0c0a09;color:#ffffff;padding:12px 24px;border-radius:6px;font-weight:600;font-size:15px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Löschung zurücknehmen</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:14px;line-height:24px;margin:24px 0 8px 0;margin-top:24px;margin-right:0;margin-bottom:8px;margin-left:0">Falls der Knopf nicht funktioniert, kopier diese Adresse in deinen Browser:</p><p style="font-size:13px;line-height:24px;word-break:break-all;color:#57534e;font-family:monospace;background-color:#f5f5f4;padding:12px;border-radius:4px;margin-top:16px;margin-bottom:16px">https://werkzirkel.de/api/v1/me/cancel-deletion</p><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Möchtest du die Löschung wirklich durchziehen? Dann musst du nichts tun — am <!-- -->15. Mai 2026<!-- --> läuft sie automatisch.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`E-Mail-Templates: Snapshots + deutsche Strings > T-005 konto-geloescht > matcht den HTML-Snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="de"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><!--$--></head><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Deine Daten wurden entfernt. Im Anhang findest du deinen JSON-Export.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><body style="background-color:#f5f5f4;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f5f5f4;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Oxygen, Ubuntu, sans-serif;margin:0;padding:32px 0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border:1px solid #e7e5e4;border-radius:8px;margin:0 auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-bottom:24px;border-bottom:1px solid #e7e5e4"><tbody><tr><td><p style="font-size:22px;line-height:24px;color:#0c0a09;font-weight:700;letter-spacing:-0.02em;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Werkzirkel</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 0;color:#1c1917;font-size:16px;line-height:1.6"><tbody><tr><td><h1 style="font-size:20px;margin:0 0 16px 0">Tschüss, <!-- -->Jana<!-- -->.</h1><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Dein Werkzirkel-Konto wurde soeben endgültig gelöscht. Dein Profil, deine Werke und alle persönlichen Daten sind aus unseren Systemen entfernt.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Im Anhang dieser E-Mail findest du eine JSON-Datei mit allen Daten, die zu deinem Konto gehört haben — falls du etwas davon archivieren oder zu einer anderen Plattform mitnehmen möchtest.</p><p style="font-size:14px;line-height:24px;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Feedback, das du zu Werken anderer hinterlassen hast, bleibt anonym erhalten. So bleibt das Werk-Feedback für die Builder:innen lesbar, ohne dass dein Name oder deine E-Mail mit drin steht.</p><p style="font-size:14px;line-height:24px;margin:24px 0 0 0;color:#78716c;margin-top:24px;margin-right:0;margin-bottom:0;margin-left:0">Falls du es dir doch anders überlegst: Du kannst dich jederzeit wieder anmelden und ein neues Konto anlegen.</p></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e7e5e4;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;border-top:1px solid #e7e5e4;color:#78716c;font-size:13px;line-height:1.6"><tbody><tr><td><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Du bekommst diese E-Mail, weil du ein Werkzirkel-Konto hast oder eines anlegen wolltest.</p><p style="font-size:13px;line-height:24px;margin:0 0 8px 0;color:#78716c;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://werkzirkel.de/impressum" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Impressum</a><a href="https://werkzirkel.de/datenschutz" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Datenschutz</a><a href="https://werkzirkel.de/einstellungen?bereich=benachrichtigungen" style="color:#78716c;text-decoration-line:none;text-decoration:underline;margin-right:12px" target="_blank">Benachrichtigungen verwalten</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;
